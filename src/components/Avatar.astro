---
// Deterministic monogram avatar; replace it when real headshots exist.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 96 } = Astro.props;

const initials = name
  .replace(/^Dr\.\s+/, '')
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

---

<svg
  class="avatar"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role="img"
  aria-label={`${name} placeholder portrait`}
>
  <rect width="100" height="100" fill="#edf5fb" />
  <text
    x="50"
    y="50"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="'Libre Franklin', sans-serif"
    font-weight="800"
    font-size="38"
    fill="#13294b">{initials}</text>
</svg>

<style>
  .avatar { display: block; border: 1px solid var(--fordham); }
</style>
