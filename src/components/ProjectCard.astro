---
import type { Project } from '../data/projects';
import { url } from '../lib/url';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const href = url(`/research/#${project.id}`);
---

<article class="pcard">
  <div class="pcard__body">
    <p class="pcard__meta">{project.status} · {project.topics.slice(0, 2).join(' / ')}</p>
    <h3 class="pcard__title"><a href={href}>{project.title}</a></h3>
    <p class="pcard__text">{compact ? project.tagline : project.summary}</p>
    <a href={href} class="pcard__more">
      Project details
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</article>

<style>
  .pcard { display: flex; border-top: 3px solid var(--navy); }
  .pcard__body { padding: 1.25rem 0; display: flex; flex-direction: column; gap: 0.7rem; flex: 1; }
  .pcard__meta { margin: 0; color: var(--old-well-basin); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .pcard__title { margin: 0; font-size: 1.2rem; }
  .pcard__title a { color: var(--navy); }
  .pcard__title a:hover { color: var(--bolin-creek); text-decoration: none; }
  .pcard__text { color: var(--ink-soft); font-size: 0.96rem; margin: 0; flex: 1; }
  .pcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--bolin-creek);
  }
  .pcard__more:hover { text-decoration: none; }
</style>
