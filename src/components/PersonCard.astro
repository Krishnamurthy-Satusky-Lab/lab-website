---
import type { Person } from '../data/people';
import Avatar from './Avatar.astro';

interface Props {
  person: Person;
  // lead: PI (largest) · wide: full-width core member · compact: small grid card
  variant?: 'lead' | 'wide' | 'compact';
}
const { person, variant = 'compact' } = Astro.props;
const avatarSize = variant === 'lead' ? 128 : variant === 'wide' ? 104 : 84;

const linkLabels: Record<string, string> = {
  email: 'Email',
  scholar: 'Scholar',
  github: 'GitHub',
  site: 'Website',
};
const entries = Object.entries(person.links ?? {}).filter(([, v]) => v && v !== '#');
const hrefFor = (k: string, v: string) => (k === 'email' && v !== '#' ? `mailto:${v}` : v);
---

<article class:list={['person', `person--${variant}`]}>
  <div class="person__avatar">
    <Avatar name={person.name} size={avatarSize} />
  </div>
  <div class="person__body">
    <h3 class="person__name">{person.name}</h3>
    <p class="person__role">{person.role}</p>
    {person.focus && <p class="person__focus">{person.focus}</p>}
    <p class="person__blurb">{person.blurb}</p>
    {person.placement && <p class="person__placement">{person.placement}</p>}
    {
      entries.length > 0 && (
        <div class="person__links">
          {entries.map(([k, v]) => (
            <a href={hrefFor(k, v as string)} rel="noopener">{linkLabels[k] ?? k}</a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .person {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    border-top: 1px solid var(--border);
    padding: 1.4rem 0;
  }
  .person__avatar { flex-shrink: 0; }
  .person__name { margin: 0 0 0.15rem; font-size: 1.12rem; }
  .person__role { margin: 0; color: var(--bolin-creek); font-weight: 600; font-size: 0.92rem; }
  .person__focus {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--old-well-basin);
    font-style: italic;
  }
  .person__blurb { margin: 0.7rem 0 0; font-size: 0.94rem; color: var(--ink-soft); }
  .person__placement {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--bolin-creek);
  }
  .person__links { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.85rem; }
  .person__links a { font-size: 0.85rem; font-weight: 600; }

  /* Full-width variants: stack on mobile, avatar beside text on wider screens. */
  .person--lead,
  .person--wide {
    flex-direction: column;
    padding: 1.5rem 0;
  }
  @media (min-width: 620px) {
    .person--lead,
    .person--wide { flex-direction: row; align-items: center; }
  }

  /* Lead (PI): heaviest emphasis. */
  .person--lead { border-top: 4px solid var(--navy); }
  @media (min-width: 620px) { .person--lead { gap: 2rem; } }
  .person--lead .person__name { font-size: 1.6rem; }
  .person--lead .person__role { font-size: 1.02rem; }

  /* Wide: full width, a step down from the lead. */
  .person--wide { border-top: 2px solid var(--carolina-blue); }
  @media (min-width: 620px) { .person--wide { gap: 1.75rem; } }
  .person--wide .person__name { font-size: 1.3rem; }
  .person--wide .person__role { font-size: 0.98rem; }
</style>
