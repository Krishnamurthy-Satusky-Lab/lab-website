---
import { site } from '../data/site';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow">{site.school}</p>
    <h1 class="hero__title">
      Carolina Health AI Lab
    </h1>
    <p class="hero__lead">{site.mission}</p>
    <div class="hero__actions">
      <a href="/research/" class="btn btn--primary">Research</a>
      <a href="/people/" class="hero__text-link">People</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: #dce7f3;
    border-bottom: 8px solid var(--carolina-blue);
  }
  .hero__inner {
    padding-block: clamp(4.5rem, 11vw, 8rem);
    max-width: 55rem;
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--carolina-blue);
    margin-bottom: 1.1rem;
  }
  .hero__title { color: #fff; margin-bottom: 1.25rem; }
  .hero__lead {
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    color: #b9c9dc;
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .hero__text-link {
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
